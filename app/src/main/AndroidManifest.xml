<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed on Android 11+ to see other apps (emulators) at all: to check whether a specific
         one is installed, and to list installed apps in the "which app should play this?" picker. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Normal protection level (auto-granted, no runtime prompt) — lets BackgroundAppCleaner ask
         Android to free other apps' cached/background processes before launching a game. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Needed to query each recommended emulator's GitHub/Gitea Releases API and download its
         latest stable APK — see LatestReleaseFinder.kt. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed to launch the system installer for a downloaded emulator APK ourselves (the
         install Intent is otherwise silently blocked without this, API 26+) — see
         PlatformsScreen.kt's downloadLatestRelease. Android still shows its own "allow installs
         from this app" prompt the first time, same as any other updater/installer app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets RomRunner see emulator APKs already sitting in Downloads (from earlier installs of itself or
         downloaded by hand) instead of fetching another copy. Granted by the user in Settings; optional. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:name=".RomRunnerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RomRunner">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RomRunner.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Separate filter (rather than folding HOME into the one above) so RomRunner shows
                 up both as a normal app-drawer icon AND as a candidate in Android's "Select Home
                 app"/Settings > Apps > Default apps > Home app picker, matching how Android
                 itself distinguishes the two roles. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
<!-- Invisible and short-lived: see GameFocus. Its own empty task affinity keeps it out of
     RomRunner's task, so closing it drops straight back to the game underneath. -->
<activity
    android:name=".FocusKickActivity"
    android:exported="false"
    android:excludeFromRecents="true"
    android:noHistory="true"
    android:taskAffinity=""
    android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
