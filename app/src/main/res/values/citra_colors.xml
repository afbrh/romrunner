<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the embedded Azahar library's "Blue" theme colors (its default, index 0) with
  RomRunner's own Indigo/Amber palette (see ui/theme/Color.kt for the Compose equivalents).
  Same resource names as azahar-src's res/values/citra_colors.xml — an app module's resource
  definitions take priority over a library dependency's when the name matches, so this reskins
  Azahar's own menus/settings/in-game overlay without touching its source at all.
-->
<resources>
    <color name="citra_primary_blue">#4B54C7</color>
    <color name="citra_onPrimary_blue">#FFFFFF</color>
    <color name="citra_primaryContainer_blue">#DEE0FF</color>
    <color name="citra_onPrimaryContainer_blue">#06104A</color>
    <color name="citra_secondary_blue">#B4690E</color>
    <color name="citra_onSecondary_blue">#FFFFFF</color>
    <color name="citra_secondaryContainer_blue">#FFDDB3</color>
    <color name="citra_onSecondaryContainer_blue">#3A2200</color>
    <color name="citra_tertiary_blue">#B4690E</color>
    <color name="citra_onTertiary_blue">#FFFFFF</color>
    <color name="citra_tertiaryContainer_blue">#FFDDB3</color>
    <color name="citra_onTertiaryContainer_blue">#3A2200</color>
    <color name="citra_background_blue">#F4F5FA</color>
    <color name="citra_onBackground_blue">#1B1B1F</color>
    <color name="citra_surface_blue">#F4F5FA</color>
    <color name="citra_onSurface_blue">#1B1B1F</color>
    <color name="citra_surfaceVariant_blue">#E2E1EC</color>
    <color name="citra_onSurfaceVariant_blue">#45464F</color>
    <color name="citra_outline_blue">#767680</color>
    <color name="citra_inverseOnSurface_blue">#F2F0F4</color>
    <color name="citra_inverseSurface_blue">#303034</color>
    <color name="citra_inversePrimary_blue">#C5CAFF</color>
    <color name="citra_surfaceTint_blue">#4B54C7</color>
</resources>
