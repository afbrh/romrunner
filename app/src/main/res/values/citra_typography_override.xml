<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides Material Components' own TextAppearance.Material3.* styles (same resource names =
  same-name override wins over ANY dependency, direct or transitive — not just azahar-src itself,
  but the com.google.android.material library it depends on). Azahar's Theme.Citra extends
  Theme.Material3.DayNight.NoActionBar, which wires every ?attr/textAppearance* theme attribute to
  these exact style names, so this reskins every menu/dialog/settings screen's font without
  touching any source in azahar-src.

  Can't parent to the original TextAppearance.Material3.* (aapt2 rejects a style parenting
  itself), and Material Components doesn't define a plain "TextAppearance.Material3" to fall back
  to implicitly either — so these parent to the generic platform android:style/TextAppearance
  instead, which is safe since every attribute that actually matters (size/line-height/
  letter-spacing, from the standard Material Design 3 type scale) is set explicitly below anyway;
  only fontFamily has actually changed from the original values.
-->
<resources>
    <style name="TextAppearance.Material3.DisplayLarge" parent="@android:style/TextAppearance">
        <item name="fontFamily">@font/silkscreen</item>
        <item name="android:fontFamily">@font/silkscreen</item>
        <item name="android:textSize">57sp</item>
        <item name="android:lineSpacingExtra">7sp</item>
        <item name="android:letterSpacing">-0.004</item>
    </style>

    <style name="TextAppearance.Material3.DisplayMedium" parent="@android:style/TextAppearance">
        <item name="fontFamily">@font/silkscreen</item>
        <item name="android:fontFamily">@font/silkscreen</item>
        <item name="android:textSize">45sp</item>
        <item name="android:lineSpacingExtra">7sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Material3.DisplaySmall" parent="@android:style/TextAppearance">
        <item name="fontFamily">@font/silkscreen</item>
        <item name="android:fontFamily">@font/silkscreen</item>
        <item name="android:textSize">36sp</item>
        <item name="android:lineSpacingExtra">8sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Material3.HeadlineLarge" parent="@android:style/TextAppearance">
