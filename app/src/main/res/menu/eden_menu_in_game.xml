<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the embedded Eden library's in-game drawer menu (same res path = same-path resource
  override wins over the library's version entirely, not merged item-by-item — see the matching
  note in eden_fragment_emulation.xml and in menu_in_game.xml, which does the same thing for
  Azahar). Per the user's request, the Switch in-game menu shows only Settings and Close Game.

  Every other stock Eden entry is kept present but invisible rather than removed outright:
  menu_lock_drawer is set via a non-null-safe `findItem(...).apply {}` in EmulationFragment.kt's
  setup code (unconditionally, regardless of visibility), so omitting it would NPE-crash on
  launch. menu_pause_emulation/menu_quick_overlay/menu_quick_settings are each read defensively
  (null-safe `?.let`/`?: return`) but are kept present anyway for consistency and to stay
  resilient to future non-null-safe changes in that file. The rest
  (menu_settings_per_game/menu_controls/menu_multiplayer/menu_load_amiibo/menu_overlay_controls)
  are only ever touched inside the click-dispatch `when(item.itemId)` block, which can't fire for
  a hidden item, so they're equally safe to keep present-but-hidden.

  No android:icon on any item, matching menu_in_game.xml's own convention.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/menu_pause_emulation"
        android:title="@string/emulation_pause"
        android:visible="false" />

    <item
        android:id="@+id/menu_quick_overlay"
        android:title="@string/emulation_show_overlay"
        android:visible="false" />

    <item
        android:id="@+id/menu_quick_settings"
        android:title="@string/quick_settings"
        android:visible="false" />

    <item
        android:id="@+id/menu_settings_per_game"
        android:title="@string/per_game_settings"
        android:visible="false" />

    <item
        android:id="@+id/menu_controls"
        android:title="@string/preferences_controls"
        android:visible="false" />

    <item
        android:id="@+id/menu_multiplayer"
        android:title="@string/multiplayer"
        android:visible="false" />

    <item
        android:id="@+id/menu_load_amiibo"
        android:title="@string/load_amiibo"
        android:visible="false" />

    <item
        android:id="@+id/menu_overlay_controls"
        android:title="@string/emulation_input_overlay"
        android:visible="false" />

    <item
        android:id="@+id/menu_lock_drawer"
        android:title="@string/emulation_input_overlay"
        android:visible="false" />

    <item
        android:id="@+id/menu_settings"
        android:title="@string/preferences_settings" />

    <!-- "Close Game" (not Eden's own @string/emulation_exit, "Exit emulation") — reusing
         Azahar's @string/emulation_close_game the same way menu_in_game.xml's own menu_exit item
         does, since both libraries' strings are merged into the same final app resource table. -->
    <item
        android:id="@+id/menu_exit"
        android:title="@string/emulation_close_game" />

</menu>
