<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the embedded Azahar library's in-game drawer menu (same res path = same-path resource
  override wins over the library's version entirely, not merged item-by-item). Compared to
  azahar-src's res/menu/menu_in_game.xml:
  - menu_cheats, menu_multiplayer, menu_amiibo, menu_overlay_options, menu_emulation_pause,
    menu_swap_screens, menu_rotate_upright are removed outright — each is only referenced inside
    a when(item.itemId) click-dispatch (or a null-safe `?.let`) in EmulationFragment.kt, so
    omitting them here is safe: no crash, those branches just never fire.
  - menu_landscape_screen_layout, menu_secondary_screen_layout, menu_lock_drawer stay present but
    invisible (not removed) — EmulationFragment.kt sets `.isVisible`/calls `.apply {}` on these
    unconditionally at setup (non-null-safe), so deleting them outright would NPE crash. They're
    still functionally wired up (see menu_display_options below), just not shown as their own
    top-level rows anymore.
  - menu_display_options is new: a single entry that opens a small chooser between "Screen Layout"
    and "Secondary Display" (see showDisplayOptionsChooser() in EmulationFragment.kt), each of
    which reuses the existing, unmodified show*Menu() functions for those two features.
  - No android:icon on any item, per request.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/menu_emulation_savestates"
        android:title="@string/savestates"
        android:visible="false" />

    <item
        android:id="@+id/menu_landscape_screen_layout"
        android:title="@string/emulation_switch_screen_layout"
        android:visible="false" />

    <item
        android:id="@+id/menu_secondary_screen_layout"
        android:title="@string/emulation_secondary_display_management"
        android:visible="false" />

    <item
        android:id="@+id/menu_lock_drawer"
        android:title="@string/lock_drawer"
        android:visible="false" />

    <item
        android:id="@+id/menu_display_options"
        android:title="@string/romrunner_display_options" />

    <item
        android:id="@+id/menu_portrait_screen_layout"
        android:title="@string/emulation_switch_portrait_layout" />

    <item
        android:id="@+id/menu_settings"
        android:title="@string/preferences_settings" />

    <item
        android:id="@+id/menu_exit"
        android:title="@string/emulation_close_game" />

</menu>
